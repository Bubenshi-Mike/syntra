{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "Syntra": {
    "Authorization": {
      "FailWhenHttpContextMissing": false
    },
    "Retry": {
      "MaxAttempts": 4,
      "BaseDelayMilliseconds": 20,
      "BackoffMultiplier": 2
    },
    "Cache": {
      "DefaultExpiration": "00:10:00"
    },
    "Idempotency": {
      "CacheDuration": "00:30:00",
      "CacheKeyPrefix": "syntra:console:idempotency:"
    }
  }
}
